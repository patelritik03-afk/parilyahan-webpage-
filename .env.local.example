# Supabase project (Settings > API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (resend.com) - for reservation + confirmation emails
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="Parilyahan Sa Kalye <reservations@yourdomain.com>"
OWNER_NOTIFICATION_EMAIL=parilyahansakalye@gmail.com

# CallMeBot (callmebot.com/blog/free-api-whatsapp-messages) - free WhatsApp webhook to the owner's own number
CALLMEBOT_PHONE=971563641028
CALLMEBOT_APIKEY=your-callmebot-apikey

# Admin login (single owner account)
# Generate a hash with: node scripts/hash-password.mjs "your-password"
# IMPORTANT: escape every $ as \$ below - Next.js expands $ in .env files and will corrupt the hash otherwise.
ADMIN_PASSWORD_HASH=\$2a\$10\$replace-with-a-real-bcrypt-hash
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Public site info
NEXT_PUBLIC_SITE_NAME="Parilyahan Sa Kalye"
# Optional overrides. By default the address links to Google Maps and reviews link to the Google listing.
# NEXT_PUBLIC_MAPS_URL=
# NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://share.google/AcPdQnB73LbaYcaZ2

# Google reviews on the home page (Google Cloud > enable "Places API (New)" > create an API key).
# Without a key, the site still works and shows the reviews you add by hand in the dashboard.
GOOGLE_PLACES_API_KEY=
# Optional - the site looks the place up by name and address if this is empty.
GOOGLE_PLACE_ID=
